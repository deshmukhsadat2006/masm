
.MODEL SMALL
.STACK 100H

.DATA
    MULTIPLICAND DB -5
    MULTIPLIER   DB 3
    RESULT       DW ?

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; M = -5, Q = +3
    MOV DL, MULTIPLICAND
    MOV BL, MULTIPLIER

    ; A = 0, Q-1 = 0
    MOV AL, 00H
    MOV BH, 00H

    ; 8 iterations
    MOV SI, 0008H

BOOTH_LOOP:
    ; Check Q0 and Q-1

    TEST BL, 01H
    JZ Q_ZERO

    ; Q0 = 1
    CMP BH, 00H
    JNZ SHIFT

    ; 10: A = A - M
    SUB AL, DL
    JMP SHIFT

Q_ZERO:
    CMP BH, 01H
    JNZ SHIFT

    ; 01: A = A + M
    ADD AL, DL

SHIFT:
    ; Save old Q0 into Q-1
    MOV BH, BL
    AND BH, 01H

    ; Shift combined A:Q arithmetically
    SHR BL, 1
    RCR AL, 1

    DEC SI
    JNZ BOOTH_LOOP

    ; Combine A and Q into result
    MOV AH, AL
    MOV AL, BL
    MOV RESULT, AX

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
