
.MODEL SMALL
.STACK 100H

.DATA
    DIVIDEND  DW 100
    DIVISOR   DW 7

    QUOTIENT  DW ?
    REMAINDER DW ?

    MSGQ    DB 13,10,'Quotient  = $'
    MSGR    DB 13,10,'Remainder = $'
    NEWLINE DB 13,10,'$'

.CODE

MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; A = 0, Q = Dividend
    XOR DX, DX
    MOV AX, DIVIDEND
    MOV BX, DIVISOR
    MOV SI, 16

RESTORE_LOOP:
    ; Shift combined A:Q left
    SHL AX, 1
    RCL DX, 1

    ; Subtract divisor from A
    SUB DX, BX
    JC RESTORE

    ; Set quotient bit to 1
    OR AX, 1
    JMP NEXT_BIT

RESTORE:
    ; Restore A
    ADD DX, BX

NEXT_BIT:
    DEC SI
    JNZ RESTORE_LOOP

    ; Save result
    MOV QUOTIENT, AX
    MOV REMAINDER, DX

    ; Display quotient
    LEA DX, MSGQ
    MOV AH, 09H
    INT 21H

    MOV AX, QUOTIENT
    CALL DISPLAY_NUMBER

    ; Display remainder
    LEA DX, MSGR
    MOV AH, 09H
    INT 21H

    MOV AX, REMAINDER
    CALL DISPLAY_NUMBER

    LEA DX, NEWLINE
    MOV AH, 09H
    INT 21H

    MOV AH, 4CH
    INT 21H

MAIN ENDP

DISPLAY_NUMBER PROC
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BX, 10
    XOR CX, CX

CONVERT:
    XOR DX, DX
    DIV BX
    PUSH DX
    INC CX

    CMP AX, 0
    JNE CONVERT

PRINT:
    POP DX
    ADD DL, '0'
    MOV AH, 02H
    INT 21H
    LOOP PRINT

    POP DX
    POP CX
    POP BX
    RET
DISPLAY_NUMBER ENDP

END MAIN
