//BT

.MODEL SMALL
.STACK 100H

.DATA
SOURCE DB 11H,22H,33H,44H,55H
DESTINATION DB 5 DUP(0FFH)

.CODE

MAIN PROC

MOV AX,@DATA
MOV DS,AX
MOV ES,AX

LEA SI,SOURCE
LEA DI,DESTINATION

MOV CX,05H
CLD

REP MOVSB

MOV AH,4CH
INT 21H
MAIN ENDP
END MAIN


//BT

.MODEL SMALL
.STACK 100H

.DATA
BLOCK1 DB 11H, 22H, 33H, 44H, 55H
BLOCK2 DB 66H, 77H, 88H, 99H, 0AAH

.CODE
MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    LEA SI, BLOCK1
    LEA DI, BLOCK2

    MOV CX, 5

EXCHANGE_LOOP:

    MOV AL, [SI]
    MOV AH, [DI]

    MOV [SI], AH
    MOV [DI], AL

    INC SI
    INC DI

    LOOP EXCHANGE_LOOP

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
