
.MODEL SMALL
.STACK 100H

.DATA

MYSTRING DB 'RIZVI$'

STRING1 DB 'HELLO ', 30 DUP('$')
STRING2 DB 'WORLD!$'

MSG1 DB 13,10,'STRING: $'
LENMSG DB 13,10,'LENGTH OF STRING: $'
CONMSG DB 13,10,'CONCATENATED STRING: $'

LENGTHVALUE DW 0

.CODE
MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

; FIND STRING LENGTH

    MOV SI, OFFSET MYSTRING
    MOV CX, 0

FIND_LENGTH_LOOP:
    CMP BYTE PTR [SI], '$'
    JE LENGTH_DONE

    INC SI
    INC CX

    JMP FIND_LENGTH_LOOP

LENGTH_DONE:
    MOV LENGTHVALUE, CX

; DISPLAY STRING

    LEA DX, MSG1
    MOV AH, 09H
    INT 21H

    LEA DX, MYSTRING
    MOV AH, 09H
    INT 21H

; DISPLAY LENGTH MESSAGE

    LEA DX, LENMSG
    MOV AH, 09H
    INT 21H

; DISPLAY LENGTH

    MOV AX, LENGTHVALUE
    ADD AL, '0'

    MOV DL, AL
    MOV AH, 02H
    INT 21H

; FIND END OF STRING1

    MOV SI, OFFSET STRING1

FIND_END_LOOP:
    CMP BYTE PTR [SI], '$'
    JE END_FOUND

    INC SI
    JMP FIND_END_LOOP

END_FOUND:
    MOV DI, SI

; POINT SI TO STRING2

    MOV SI, OFFSET STRING2

; COPY STRING2 TO STRING1

COPY_LOOP:
    CMP BYTE PTR [SI], '$'
    JE COPY_DONE

    MOV AL, [SI]
    MOV [DI], AL

    INC SI
    INC DI

    JMP COPY_LOOP

COPY_DONE:
    MOV BYTE PTR [DI], '$'

; DISPLAY CONCATENATED STRING

    LEA DX, CONMSG
    MOV AH, 09H
    INT 21H

    LEA DX, STRING1
    MOV AH, 09H
    INT 21H

; EXIT PROGRAM

    MOV AH, 4CH
    MOV AL, 00H
    INT 21H

MAIN ENDP
END MAIN
