
.MODEL SMALL
.STACK 100H

.DATA
MSG1 DB 'ENTER FIRST DIGIT: $'
MSG2 DB 13,10,'ENTER SECOND DIGIT: $'
MSG3 DB 13,10,'SUM: $'

.CODE
MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

; INPUT FIRST DIGIT

    LEA DX, MSG1
    MOV AH, 09H
    INT 21H

    MOV AH, 01H
    INT 21H
    SUB AL, '0'
    MOV BL, AL

; INPUT SECOND DIGIT

    LEA DX, MSG2
    MOV AH, 09H
    INT 21H

    MOV AH, 01H
    INT 21H
    SUB AL, '0'

; BCD ADDITION

    ADD AL, BL
    DAA

; SAVE RESULT

    MOV BL, AL

; DISPLAY SUM MESSAGE

    LEA DX, MSG3
    MOV AH, 09H
    INT 21H

; DISPLAY TENS DIGIT

    MOV DL, BL
    MOV CL, 4
    SHR DL, CL
    ADD DL, '0'
    MOV AH, 02H
    INT 21H

; DISPLAY ONES DIGIT

    MOV DL, BL
    AND DL, 0FH
    ADD DL, '0'
    MOV AH, 02H
    INT 21H

; EXIT

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
8
