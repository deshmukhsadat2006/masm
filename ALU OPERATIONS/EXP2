
.MODEL SMALL
.STACK 100H

.DATA
MSG1 DB 'ENTER FIRST DIGIT: $'
MSG2 DB 13,10,'ENTER SECOND DIGIT: $'
MSG3 DB 13,10,'ADDITION: $'
MSG4 DB 13,10,'SUBTRACTION: $'
MSG5 DB 13,10,'MULTIPLICATION: $'
MSG6 DB 13,10,'DIVISION: $'
MSG7 DB 13,10,'AND: $'
MSG8 DB 13,10,'OR: $'

.CODE
MAIN PROC

MOV AX, @DATA
MOV DS, AX

LEA DX, MSG1
MOV AH, 09H
INT 21H

MOV AH, 01H
INT 21H
SUB AL, 30H
MOV BL, AL

LEA DX, MSG2
MOV AH, 09H
INT 21H

MOV AH, 01H
INT 21H
SUB AL, 30H
MOV BH, AL

; ADDITION
LEA DX, MSG3
MOV AH, 09H
INT 21H

MOV AL, BL
ADD AL, BH
AAM
MOV CX, AX

MOV DL, CH
ADD DL, 30H
MOV AH, 02H
INT 21H

MOV DL, CL
ADD DL, 30H
MOV AH, 02H
INT 21H

; SUBTRACTION (first digit >= second digit)
LEA DX, MSG4
MOV AH, 09H
INT 21H

MOV AL, BL
SUB AL, BH
ADD AL, 30H
MOV DL, AL
MOV AH, 02H
INT 21H

; MULTIPLICATION
LEA DX, MSG5
MOV AH, 09H
INT 21H

MOV AL, BL
MUL BH
AAM
MOV CX, AX

MOV DL, CH
ADD DL, 30H
MOV AH, 02H
INT 21H

MOV DL, CL
ADD DL, 30H
MOV AH, 02H
INT 21H

; DIVISION (second digit must not be zero)
LEA DX, MSG6
MOV AH, 09H
INT 21H

MOV AL, BL
MOV AH, 00H
DIV BH

MOV DL, AL
ADD DL, 30H
MOV AH, 02H
INT 21H



; AND OPERATION
LEA DX, MSG7
MOV AH, 09H
INT 21H

MOV AL, BL
AND AL, BH
ADD AL, 30H
MOV DL, AL
MOV AH, 02H
INT 21H



; OR OPERATION
LEA DX, MSG8
MOV AH, 09H
INT 21H

MOV AL, BL
OR AL, BH
ADD AL, 30H
MOV DL, AL
MOV AH, 02H
INT 21H

MOV AH, 4CH
INT 21H

MAIN ENDP
END MAIN
